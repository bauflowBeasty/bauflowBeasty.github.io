---
/**
 * Global search (Pagefind) in the header: a button + a modal dialog.
 * Ctrl/⌘ K opens it. Pagefind's UI (CSS + JS) loads the first time it opens,
 * so pages that never search pay nothing. Each Pagefind index is per language
 * (the <html lang>), and results name their product (data-pagefind-meta).
 */
import { t, type Lang } from '../data/ui-strings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<button class="search-trigger" type="button" data-search-open aria-haspopup="dialog">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5"></path>
  </svg>
  <span class="search-trigger__label">{t(lang, 'search.open')}</span>
  <kbd>Ctrl K</kbd>
</button>

<dialog class="search-dialog" data-search-dialog aria-label={t(lang, 'search.open')}>
  <div class="search-dialog__bar">
    <button type="button" class="search-dialog__close" data-search-close aria-label={t(lang, 'search.close')}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>
  <div id="search" data-placeholder={t(lang, 'docs.searchPlaceholder')}></div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  let loading: Promise<void> | null = null;

  // Loads Pagefind's UI once. In `npm run dev` there is no index: the dialog just stays empty.
  function loadPagefind(): Promise<void> {
    if (loading) return loading;
    loading = new Promise((resolve) => {
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/pagefind/pagefind-ui.css';
      document.head.append(css);
      const js = document.createElement('script');
      js.src = '/pagefind/pagefind-ui.js';
      js.onload = () => {
        const w = window as unknown as { PagefindUI?: new (opts: object) => unknown };
        const mount = document.getElementById('search');
        if (w.PagefindUI && mount) {
          new w.PagefindUI({
            element: '#search',
            showImages: false,
            showSubResults: true,
            translations: { placeholder: mount.dataset.placeholder },
          });
        }
        resolve();
      };
      js.onerror = () => resolve();
      document.head.append(js);
    });
    return loading;
  }

  async function openSearch() {
    if (!dialog) return;
    if (!dialog.open) dialog.showModal();
    await loadPagefind();
    dialog.querySelector<HTMLInputElement>('input')?.focus();
  }

  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', openSearch));
  dialog?.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());
  // Click on the backdrop (outside the panel) closes.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  document.addEventListener('keydown', (e) => {
    if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'k') return;
    const target = e.target as HTMLElement | null;
    const typing = target?.closest('input, textarea, [contenteditable=""], [contenteditable="true"]');
    if (typing && !dialog?.contains(target)) return;
    e.preventDefault();
    openSearch();
  });
</script>

<style>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.5rem 0.35rem 0.7rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-bounce);
  }

  .search-trigger:hover {
    color: var(--text);
    border-color: var(--accent-strong);
    transform: translateY(-1px);
  }

  .search-trigger:active {
    animation: squash 0.3s var(--ease-bounce);
  }

  kbd {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .search-dialog {
    width: min(44rem, calc(100vw - 2rem));
    max-height: min(80vh, 44rem);
    margin: 10vh auto auto;
    padding: var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-pop);
    overflow-y: auto;

    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: var(--accent-text);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--border-strong);
    --pagefind-ui-tag: var(--surface-raised);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius-md);
    --pagefind-ui-font: var(--font-body);
  }

  .search-dialog[open] {
    animation: pop 0.3s var(--ease-bounce);
  }

  /* Pagefind highlights matches with a yellow <mark>: use the brand red instead. */
  .search-dialog :global(mark) {
    background: color-mix(in srgb, var(--accent-strong) 28%, transparent);
    color: var(--text);
    border-radius: 2px;
  }

  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(3px);
  }

  .search-dialog__bar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-2);
  }

  .search-dialog__close {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-md);
    color: var(--text-muted);
  }

  .search-dialog__close:hover {
    color: var(--text);
    background: var(--accent-soft);
  }

  @media (max-width: 760px) {
    .search-trigger {
      padding: 0.45rem;
    }

    .search-trigger__label,
    kbd {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
