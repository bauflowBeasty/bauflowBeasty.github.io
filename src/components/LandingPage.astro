---
/**
 * Landing: short intro → featured project (red block) → catalog with filters →
 * how the Unity packages fit together. Scales to any number of projects.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeIntro from './HomeIntro.astro';
import FeaturedProject from './FeaturedProject.astro';
import ProjectCatalog from './ProjectCatalog.astro';
import EcosystemNote from './EcosystemNote.astro';
import { PRODUCTS } from '../data/products';
import { getFeatured } from '../lib/catalog';
import { t, type Lang } from '../data/ui-strings';
import '../styles/landing.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const altHref = lang === 'en' ? '/es/' : '/';
const featured = getFeatured(PRODUCTS);
---

<BaseLayout
  title={lang === 'en' ? 'Beasty Components — Unity tools by bauflow' : 'Beasty Components — Herramientas para Unity por bauflow'}
  description={t(lang, 'hero.sub')}
  lang={lang}
  altHref={altHref}
>
  <HomeIntro lang={lang} />

  <div class="container landing-featured">
    <FeaturedProject product={featured} lang={lang} />
  </div>

  <div class="container landing-catalog">
    <ProjectCatalog
      products={PRODUCTS}
      lang={lang}
      featuredId={featured.id}
      withFilters
      id="catalog"
      heading={t(lang, 'products.heading')}
      hideHeading
    />
  </div>

  <div class="container landing-ecosystem">
    <EcosystemNote lang={lang} />
  </div>
</BaseLayout>
