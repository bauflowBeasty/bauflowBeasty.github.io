---
/**
 * «Where to get it» on a project page: one official widget per store that has
 * one (loaded only with the visitor's permission), the rest as store buttons.
 * Out of the search index; build-pdf.mjs strips it (no nested <section>!).
 */
import type { Product } from '../data/products';
import { STORES } from '../data/stores';
import { t, type Lang } from '../data/ui-strings';
import StoreWidget from './StoreWidget.astro';
import StoreButtons from './StoreButtons.astro';

interface Props {
  product: Product;
  lang: Lang;
}

const { product, lang } = Astro.props;
const withWidget = product.storeLinks.filter((l) => l.url && l.widgetId && STORES[l.store]?.widget);
const others = product.storeLinks.filter((l) => !withWidget.includes(l));
---

<section class="where-to-get" data-pagefind-ignore="all" data-where-to-get>
  <h2>{t(lang, 'where.heading')}</h2>
  {
    withWidget.length > 0 && (
      <div class="where-to-get__widgets">
        {withWidget.map((link) => (
          <StoreWidget link={link} product={product} lang={lang} />
        ))}
      </div>
    )
  }
  {others.length > 0 && <StoreButtons product={{ ...product, storeLinks: others }} lang={lang} />}
  {
    withWidget.length > 0 && (
      <div class="where-to-get__consent" hidden>
        <label class="where-to-get__remember">
          <input type="checkbox" data-widget-remember checked />
          {t(lang, 'widget.remember')}
        </label>
        <button type="button" class="where-to-get__revoke" data-widget-revoke hidden>
          {t(lang, 'widget.revoke')}
        </button>
      </div>
    )
  }
</section>

<script>
  import { initStoreWidgets } from '../scripts/store-widgets';
  initStoreWidgets(document);
</script>

<style>
  .where-to-get {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .where-to-get h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-lg);
  }

  .where-to-get h2::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    flex: none;
    border-radius: 2px;
    background: var(--accent-strong);
    transform: rotate(45deg);
  }

  .where-to-get__widgets {
    display: grid;
    gap: var(--space-3);
  }

  .where-to-get__consent {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .where-to-get__consent[hidden],
  .where-to-get__remember[hidden],
  .where-to-get__revoke[hidden] {
    display: none;
  }

  .where-to-get__remember {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
  }

  .where-to-get__remember input {
    accent-color: var(--accent);
  }

  .where-to-get__revoke {
    color: var(--accent-text);
    font-size: var(--text-sm);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
