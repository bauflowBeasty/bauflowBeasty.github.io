---
/**
 * Site header: logo · Projects dropdown · Contact · search (Ctrl K) · language · theme.
 * No per-product links: the Projects dropdown scales to any number of projects.
 */
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';
import ProjectsMenu from './ProjectsMenu.astro';
import SiteSearch from './SiteSearch.astro';
import { t, type Lang } from '../data/ui-strings';
import logoOnDark from '../assets/logo-on-dark.svg';
import logoOnLight from '../assets/logo-on-light.svg';

interface Props {
  lang: Lang;
  altHref: string;
}

const { lang, altHref } = Astro.props;
const prefix = lang === 'es' ? '/es' : '';
---

<header class="site-header">
  <div class="container header-row">
    <a class="brand" href={`${prefix}/`}>
      <img class="logo logo-dark" src={logoOnDark.src} alt={t(lang, 'logo.alt')} width="110" />
      <img class="logo logo-light" src={logoOnLight.src} alt={t(lang, 'logo.alt')} width="110" />
    </a>

    <nav class="main-nav" aria-label={t(lang, 'nav.projects')}>
      <ProjectsMenu lang={lang} />
      <a class="nav-link" href={`${prefix}/contact/`}>{t(lang, 'contact.title')}</a>
    </nav>

    <div class="header-tools">
      <SiteSearch lang={lang} />
      <LangSwitch lang={lang} altHref={altHref} />
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .header-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 100%;
  }

  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo {
    height: 1.7rem;
    width: auto;
  }

  .brand:hover .logo {
    animation: wiggle 0.45s ease;
  }

  :global(html[data-theme='dark']) .logo-light,
  :global(html[data-theme='light']) .logo-dark {
    display: none;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav-link {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--accent-soft);
    text-decoration: none;
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }

  @media (max-width: 640px) {
    .header-row {
      gap: var(--space-2);
    }

    /* Contact stays reachable from the footer. */
    .nav-link {
      display: none;
    }
  }
</style>
