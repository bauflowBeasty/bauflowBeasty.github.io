---
/**
 * The featured project: a whole block in brand red («Rojo protagonista»).
 * Big cover, «NEW · vX» pill, name, tagline and the store buttons (black pills).
 * «Modo juego»: slams in on load; a spotlight follows the pointer.
 */
import type { Product } from '../data/products';
import { t, type Lang } from '../data/ui-strings';
import { projectHref } from '../lib/catalog';
import Cover from './Cover.astro';
import StoreButtons from './StoreButtons.astro';

interface Props {
  product: Product;
  lang: Lang;
}

const { product, lang } = Astro.props;
const href = projectHref(product, lang);
---

<section id="featured" class="featured on-brand" data-spotlight>
  <a class="featured__media" href={href} tabindex="-1" aria-hidden="true">
    <Cover id={product.id} name={product.name} size="hero" eager />
  </a>
  <div class="featured__body">
    <p class="featured__kicker">{t(lang, 'featured.new')} · <span class="featured__version">v{product.version}</span></p>
    <h2 class="featured__name"><a href={href}>{product.name}</a></h2>
    <p class="featured__tagline">{product.tagline[lang]}</p>
    <StoreButtons product={product} lang={lang} />
  </div>
</section>

<script>
  import { attachSpotlight } from '../scripts/juice';
  document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((el) => attachSpotlight(el));
</script>

<style>
  .featured {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-6);
    overflow: hidden;
    border-radius: calc(var(--radius-lg) + 4px);
    background: var(--brand-surface);
    color: var(--brand-on);
    animation: slam 0.7s var(--ease-bounce) backwards;
    animation-delay: 0.3s;
  }

  /* Spotlight that follows the pointer (attachSpotlight writes --mx/--my). */
  .featured::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(320px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, 0.2), transparent 60%);
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .featured:hover::before {
    opacity: 1;
  }

  .featured > * {
    position: relative;
  }

  .featured__media {
    display: block;
    transform: rotate(-2deg);
    transition: transform var(--dur-slow) var(--ease-bounce);
  }

  .featured:hover .featured__media {
    transform: rotate(0deg) scale(1.02);
  }

  .featured__media :global(.cover) {
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
  }

  .featured__kicker {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--brand-ink);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured__version {
    text-transform: none;
  }

  .featured__name {
    margin-block: var(--space-3) var(--space-2);
    font-size: var(--text-xl);
    font-weight: 800;
    line-height: 1.05;
  }

  .featured__name a {
    color: inherit;
  }

  .featured__name a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }

  .featured__tagline {
    margin-bottom: var(--space-5);
    font-size: var(--text-md);
    font-weight: 600;
  }

  .featured :global(:focus-visible) {
    outline-color: var(--brand-on);
  }

  @media (max-width: 860px) {
    .featured {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-5);
      gap: var(--space-5);
    }
  }
</style>
