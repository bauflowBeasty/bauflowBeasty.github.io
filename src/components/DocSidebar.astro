---
import { getCollection } from 'astro:content';
import { SIDEBARS } from '../data/sidebars';
import ProjectSwitcher from './ProjectSwitcher.astro';
import { t, type Lang } from '../data/ui-strings';

interface Props {
  productId: string;
  lang: Lang;
  /** Site path of the page being rendered, used to mark the active item. */
  currentPath: string;
}

const { productId, lang, currentPath } = Astro.props;
const prefix = lang === 'es' ? '/es' : '';
const groups = SIDEBARS[productId];

// slug -> title lookup for this product+lang, from page frontmatter
const entries = await getCollection('docs', (e) => e.id.startsWith(`${lang}/${productId}/`));
const titles = new Map(
  entries.map((e) => [e.id.replace(`${lang}/${productId}/`, ''), e.data.title])
);

const hrefFor = (item: string) => `${prefix}/docs/${productId}/${item}/`;
const isActive = (href: string) => currentPath.replace(/\/$/, '') === href.replace(/\/$/, '');
const overviewHref = `${prefix}/docs/${productId}/`;
---

<nav class="doc-sidebar" aria-label={t(lang, 'nav.docs')}>
  <ProjectSwitcher current={productId} lang={lang} />

  <a class="sidebar-item overview" href={overviewHref} aria-current={isActive(overviewHref) ? 'page' : undefined}>
    {t(lang, 'docs.overview')}
  </a>

  {
    groups.map((group) => (
      <section class="sidebar-group">
        <h3 class="machine">{group.label[lang]}</h3>
        <ul>
          {group.items.map((item) => {
            const href = hrefFor(item);
            return (
              <li>
                <a class="sidebar-item" href={href} aria-current={isActive(href) ? 'page' : undefined}>
                  {titles.get(item) ?? item}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</nav>

<style>
  .doc-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-sm);
  }

  .sidebar-group h3 {
    margin-bottom: var(--space-2);
    color: var(--text-faint);
  }

  .sidebar-group ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  /* «Limpia»: hover nudges right while a red bar grows; the active page gets a soft fill + bar. */
  .sidebar-item {
    position: relative;
    display: block;
    padding: 0.3rem var(--space-3) 0.3rem 0.9rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    line-height: 1.45;
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out),
      transform var(--dur-base) var(--ease-bounce);
  }

  .sidebar-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 0;
    border-radius: 2px;
    background: var(--accent-strong);
    transform: translateY(-50%);
    transition: height var(--dur-base) var(--ease-bounce);
  }

  .sidebar-item:hover {
    text-decoration: none;
    color: var(--text);
    transform: translateX(3px);
  }

  .sidebar-item:hover::before {
    height: 50%;
  }

  .sidebar-item[aria-current='page'] {
    color: var(--text);
    background: var(--accent-soft);
    font-weight: 700;
  }

  .sidebar-item[aria-current='page']::before {
    height: 70%;
  }

  .sidebar-item.overview {
    font-weight: 700;
  }
</style>
