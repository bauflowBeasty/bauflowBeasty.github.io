---
import { t, type Lang } from '../data/ui-strings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const prefix = lang === 'es' ? '/es' : '';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-row">
    <div>
      <p class="footer-tagline">{t(lang, 'footer.tagline')}</p>
      <p class="machine">© {year} bauflow · {t(lang, 'footer.rights')}</p>
    </div>
    <div class="footer-contact">
      <span class="eyebrow">{t(lang, 'footer.contact')}</span>
      <a href={`${prefix}/contact/`}>{t(lang, 'footer.contactLink')}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: var(--space-6);
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    justify-content: space-between;
    align-items: flex-end;
  }

  .footer-tagline {
    font-family: var(--font-display);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-sm);
  }
</style>
