---
/**
 * Grid of project cards, optionally with platform filters generated from the
 * products (only platforms that exist; none at all when there is just one).
 * Without JavaScript the filters stay hidden and the full catalog shows.
 */
import type { Product } from '../data/products';
import { t, type Lang } from '../data/ui-strings';
import { PLATFORMS } from '../data/platforms';
import { platformFilters } from '../lib/catalog';
import ProjectCard from './ProjectCard.astro';

interface Props {
  products: Product[];
  lang: Lang;
  heading: string;
  featuredId?: string;
  withFilters?: boolean;
  id?: string;
  /** Keep the heading for screen readers only. */
  hideHeading?: boolean;
}

const { products, lang, heading, featuredId, withFilters = false, id, hideHeading = false } = Astro.props;
const filters = withFilters ? platformFilters(products) : [];
---

<section class="catalog" id={id} data-catalog>
  <h2 class:list={['catalog__heading', { 'visually-hidden': hideHeading }]}>{heading}</h2>
  {
    filters.length > 0 && (
      <div class="catalog-filters" role="group" aria-label={t(lang, 'catalog.filterLabel')} hidden>
        <button type="button" class="chip" data-filter="all" aria-pressed="true" style="--i:0">
          {t(lang, 'catalog.all')}
        </button>
        {filters.map((f, i) => (
          <button type="button" class="chip" data-filter={f.id} aria-pressed="false" style={`--i:${i + 1}`}>
            {PLATFORMS[f.id].label}
            <span class="chip__count">{f.count}</span>
          </button>
        ))}
      </div>
    )
  }
  <div class="catalog-grid">
    {products.map((p, i) => <ProjectCard product={p} lang={lang} featured={p.id === featuredId} index={i} />)}
  </div>
</section>

<script>
  import { isCardVisible, type Filter } from '../lib/catalog';
  import { attachTilt } from '../scripts/juice';

  document.querySelectorAll<HTMLElement>('[data-catalog]').forEach((catalog) => {
    const cards = Array.from(catalog.querySelectorAll<HTMLElement>('.project-card'));
    cards.forEach((card) => attachTilt(card));

    const group = catalog.querySelector<HTMLElement>('.catalog-filters');
    if (!group) return;
    group.hidden = false;
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-filter]'));

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const filter = button.dataset.filter as Filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        let n = 0;
        for (const card of cards) {
          const visible = isCardVisible(
            { platforms: (card.dataset.platforms ?? '').split(','), featured: card.hasAttribute('data-featured') },
            filter
          );
          card.hidden = !visible;
          if (!visible) continue;
          // Re-run the entrance with a pop, staggered in the new order.
          card.style.setProperty('--i', String(n++));
          card.style.setProperty('--reveal-name', 'pop');
          card.style.setProperty('--reveal-base', '0ms');
          card.classList.remove('reveal');
          void card.offsetWidth;
          card.classList.add('reveal');
        }
      })
    );
  });
</script>

<style>
  .catalog {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .catalog__heading {
    font-size: var(--text-lg);
  }

  .catalog-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    animation: pop 0.45s var(--ease-bounce) backwards;
    animation-delay: calc(0.3s + var(--i, 0) * 50ms);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .chip:hover {
    color: var(--text);
    border-color: var(--accent-strong);
  }

  .chip:active {
    animation: squash 0.3s var(--ease-bounce);
  }

  .chip[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-on);
  }

  .chip__count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0.75;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-5);
  }
</style>
