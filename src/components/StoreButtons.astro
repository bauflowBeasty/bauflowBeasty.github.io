---
/**
 * One pill per store: logo + label, all alike so 6–8 stores fit without noise.
 * On red surfaces (inside .on-brand) they turn into black pills.
 * `url: null` → disabled «Coming soon» pill.
 */
import type { Product } from '../data/products';
import { t, type Lang } from '../data/ui-strings';
import StoreLogo from './StoreLogo.astro';

interface Props {
  product: Product;
  lang: Lang;
  compact?: boolean;
}

const { product, lang, compact = false } = Astro.props;
---

<div class:list={['store-buttons', { compact }]}>
  {
    product.storeLinks.map((link) =>
      link.url ? (
        <a class="store-btn" href={link.url} rel="noopener">
          <StoreLogo store={link.store} size={compact ? 14 : 16} />
          <span>{link.label}</span>
        </a>
      ) : (
        <span class="store-btn disabled" aria-disabled="true" title={t(lang, 'product.comingSoon')}>
          <StoreLogo store={link.store} size={compact ? 14 : 16} />
          <span>{link.label}</span>
          <small>{t(lang, 'product.comingSoon')}</small>
        </span>
      )
    )
  }
</div>

<style>
  .store-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-weight: 700;
    font-size: var(--text-sm);
    line-height: 1.2;
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease-bounce),
      border-color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .store-btn:hover {
    text-decoration: none;
    transform: translateY(-2px);
    border-color: var(--accent-strong);
  }

  .store-btn:active {
    animation: squash 0.3s var(--ease-bounce);
  }

  /* Black pills on the red brand surface (featured block, project header). */
  :global(.on-brand) .store-btn {
    background: var(--brand-ink);
    border-color: var(--brand-ink);
    color: #ffffff;
  }

  :global(.on-brand) .store-btn:hover {
    background: #000000;
    border-color: #000000;
  }

  .store-btn.disabled {
    color: var(--text-muted);
    border-style: dashed;
    cursor: default;
  }

  .store-btn.disabled:hover {
    transform: none;
    border-color: var(--border-strong);
  }

  .store-btn.disabled small {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-text);
  }

  .compact .store-btn {
    padding: 0.3rem 0.7rem;
    font-size: var(--text-xs);
  }
</style>
