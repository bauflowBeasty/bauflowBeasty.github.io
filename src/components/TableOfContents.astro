---
import type { MarkdownHeading } from 'astro';
import { t, type Lang } from '../data/ui-strings';

interface Props {
  headings: MarkdownHeading[];
  lang: Lang;
}

const { headings, lang } = Astro.props;
const visible = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  visible.length > 1 && (
    <nav class="toc" aria-label={t(lang, 'docs.onThisPage')}>
      <h2 class="machine">{t(lang, 'docs.onThisPage')}</h2>
      <ul>
        {visible.map((h) => (
          <li class:list={[`depth-${h.depth}`]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    font-size: var(--text-xs);
  }

  .toc h2 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
    margin-bottom: var(--space-2);
  }

  .toc ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .toc a {
    display: block;
    padding: 0.22rem 0 0.22rem var(--space-3);
    color: var(--text-muted);
    border-left: 2px solid var(--border);
    line-height: 1.4;
  }

  .toc li.depth-3 a {
    padding-left: var(--space-5);
  }

  .toc a:hover {
    text-decoration: none;
    color: var(--text);
  }

  .toc a.active {
    color: var(--accent-text);
    border-left-color: var(--accent);
  }
</style>

<script>
  // Scroll spy: highlight the TOC entry of the heading in view.
  const toc = document.querySelector('.toc');
  if (toc) {
    const links = new Map(
      [...toc.querySelectorAll('a[href^="#"]')].map((a) => [
        decodeURIComponent(a.getAttribute('href')!.slice(1)),
        a,
      ])
    );
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((a) => a.classList.remove('active'));
          links.get(entry.target.id)?.classList.add('active');
        }
      },
      { rootMargin: '-15% 0px -75% 0px' }
    );
    links.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }
</script>
